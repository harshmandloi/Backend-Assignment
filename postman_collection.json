    {
      "name": "Sessions",
      "item": [
        {
          "name": "Create Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.session && res.data.session._id) {",
                  "    pm.collectionVariables.set('sessionId', res.data.session._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"2026-10-25T10:00:00.000Z\",\n  \"endTime\": \"2026-10-25T11:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            }
          }
        },
        {
          "name": "Get Available Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available?dateTimestamp=2026-10-25",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "available"],
              "query": [
                {
                  "key": "dateTimestamp",
                  "value": "2026-10-25"
                }
              ]
            }
          }
        },
        {
          "name": "Book Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "book"]
            }
          }
        },
        {
          "name": "Mark Session Complete",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "complete"]
            }
          }
        },
